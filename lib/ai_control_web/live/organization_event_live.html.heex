<Layouts.app flash={@flash} current_scope={@current_scope} active_page="events">
  <div class="page-content" id="event-details">
    <.link
      navigate={~p"/organizations/#{@current_scope.organization.id}/events"}
      class="text-link"
      id="event-back"
    >All events</.link>
    <h1 class="mt-6">Event details</h1>
    <p class="page-description">{@event.event_type} · {ReportingHTML.time(@event.occurred_at)}</p>
    <dl class="report-facts">
      <div>
        <dt>Request ID</dt><dd class="resource-identifier">{@event.request_id}</dd>
      </div>
      <div :if={@event.run_id} id="event-run-reference">
        <dt>Workflow ID</dt><dd class="resource-identifier">{@event.run_id}</dd>
      </div>
      <div :if={@event.participant_id} id="event-participant-reference">
        <dt>Participant ID</dt><dd class="resource-identifier">{@event.participant_id}</dd>
      </div>
      <div>
        <dt>Stage</dt><dd>{@event.stage}</dd>
      </div>
      <div>
        <dt>Action / reason</dt><dd>
          {if @event.action,
            do: ReportingHTML.label(@event.action),
            else: Enum.join(@event.reason_codes, ", ")}
        </dd>
      </div>
      <div>
        <dt>Policy version</dt><dd class="resource-identifier">
          {@event.policy_version || "Not recorded"}
        </dd>
      </div>
      <div>
        <dt>Policy checksum</dt><dd class="resource-identifier">
          {@event.policy_checksum || "Not recorded"}
        </dd>
      </div>
    </dl>
    <section class="list-section" aria-labelledby="request-chronology-heading">
      <h2 id="request-chronology-heading">Request chronology</h2>
      <div id="request-chronology" phx-update="stream">
        <ReportingHTML.event_row
          :for={{id, event} <- @streams.chronology}
          id={id}
          event={event}
          organization_id={@current_scope.organization.id}
        />
      </div>
    </section>
    <section class="list-section" aria-labelledby="event-evidence-heading">
      <div
        :if={@granite_status}
        id="event-granite"
        class="mb-6"
        aria-labelledby="event-granite-heading"
      >
        <h2 id="event-granite-heading">Deep semantic analysis</h2>
        <p class="muted mt-2">
          Recorded status: {@granite_status}. These results use the historical criterion and model digest.
        </p>
        <div id="event-granite-checks" phx-update="stream">
          <div :for={{id, check} <- @streams.granite_checks} id={id} class="mt-4">
            <h3 class="font-medium break-all">{check["criterion_id"]}</h3>
            <p class="muted mt-1">
              {granite_trigger(check["trigger"])}. {granite_outcome(check)}
            </p>
            <p class="muted mt-1 break-all">Criterion hash: {check["criterion_hash"]}</p>
          </div>
        </div>
      </div>
      <p :if={@model_signal} id="event-model-signal" class="muted mb-4">{@model_signal}</p>
      <h2 id="event-evidence-heading">Recorded evidence</h2><p class="muted mt-2">
        Rule and detector IDs, measured signals, classifier labels or malicious scores and safe usage. Scores are not calibrated probabilities. Model proposals do not prove tool execution.
      </p><pre
        id="event-evidence"
        class="evidence-json"
        tabindex="0"
        aria-labelledby="event-evidence-heading"
      >{@evidence}</pre>
    </section>
  </div>
</Layouts.app>
