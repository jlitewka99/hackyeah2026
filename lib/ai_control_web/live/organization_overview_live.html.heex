<Layouts.app flash={@flash} current_scope={@current_scope} active_page="overview">
  <div class="page-content" id="organization-overview">
    <h1 class="break-words">Overview</h1>
    <p class="page-description">
      {@current_scope.organization.name} · Protection, activity and resources from actual gateway evidence.
    </p>
    <ReportingHTML.related_links scope={@current_scope} id="overview-report-links" />
    <%= if "events.read" in @current_scope.grants.permissions do %>
      <ReportingHTML.filters form={@form} id="overview-filters" />
      <p class="report-range muted">
        {ReportingHTML.time(@filters.from)} — {ReportingHTML.time(@filters.to)}
      </p>
    <% end %>
    <div class="overview-primary">
      <%= if "events.read" in @current_scope.grants.permissions do %>
        <%= if ReportingHTML.ok?(@reports.activity) do %>
          <% activity = ReportingHTML.value(@reports.activity) %>
          <section id="overview-activity" class="list-section" aria-labelledby="activity-heading">
            <h2 id="activity-heading">Gateway activity</h2><p class="muted mt-2">
              {activity.total} terminal requests. Each request counts once; phase decisions remain in Events.
            </p>
            <p class="muted text-sm mt-2" id="overview-operations">
              Chat: {activity.operations["chat"] || 0} · Model catalog: {activity.operations[
                "models"
              ] || 0} · Operation not recorded: {activity.operations["not_recorded"] || 0}
            </p>
            <dl class="report-summary">
              <div
                :for={key <- ~w(allow redact block review budget_denied service_error rejected)}
                id={"overview-count-#{key}"}
              >
                <dt>{ReportingHTML.label(key)}</dt><dd>{activity.counts[key]}</dd>
              </div>
            </dl>
          </section>
        <% else %>
          <p role="alert" id="overview-report-error" class="report-error">
            Activity could not be loaded. Try again shortly.
          </p>
        <% end %>
      <% end %>
      <%= if "budgets.read" in @current_scope.grants.permissions do %>
        <section
          id="overview-budget"
          class="list-section"
          aria-labelledby="overview-budget-heading"
        >
          <h2 id="overview-budget-heading">Current hourly budget</h2>
          <%= if ReportingHTML.ok?(@reports.budgets) do %>
            <% budget = ReportingHTML.value(@reports.budgets) %>
            <p class="muted mt-2">
              {ReportingHTML.time(budget.window)} — {ReportingHTML.time(budget.ends_at)}
            </p>
            <dl class="report-summary">
              <div>
                <dt>Admitted requests</dt><dd>
                  {budget.bucket.requests}<span class="muted"> / {ReportingHTML.limit(
                    budget.policy.limits["organization"]["requests_per_hour"]
                  )}</span>
                </dd>
              </div><div>
                <dt>Settled tokens</dt><dd>
                  {budget.bucket.tokens}<span class="muted"> / {ReportingHTML.limit(
                    budget.policy.limits["organization"]["tokens_per_hour"]
                  )}</span>
                </dd>
              </div><div>
                <dt>Reserved tokens</dt><dd>{budget.bucket.reserved}</dd>
              </div>
            </dl>
          <% else %>
            <p role="alert" class="report-error">
              Budget usage is unavailable. Try again shortly.
            </p>
          <% end %>
        </section>
      <% end %>
    </div>
    <%= if ReportingHTML.ok?(@reports.activity) do %>
      <section
        id="overview-performance"
        class="list-section"
        aria-labelledby="performance-heading"
      >
        <h2 id="performance-heading">Measured latency</h2><p class="muted mt-2">
          Milliseconds, nearest-rank percentiles. Gateway total ends before the terminal audit write. Stages can overlap.
        </p>
        <div role="table" aria-label="Measured latency in milliseconds">
          <div role="row" class="latency-header muted text-sm">
            <span role="columnheader">Measurement</span><span role="columnheader">p50</span><span role="columnheader">p95</span><span role="columnheader">Samples</span>
          </div>
          <div id="latency-list" role="rowgroup" phx-update="stream">
            <p id="latencies-empty" class="hidden only:block muted py-6">
              Not recorded. Measurements appear after new gateway requests.
            </p>
            <div :for={{id, sample} <- @streams.latencies} id={id} role="row" class="latency-row">
              <span role="rowheader">{ReportingHTML.timing_label(sample.id)}</span><span role="cell">{ReportingHTML.latency(
                sample.p50
              )}</span><span role="cell">{ReportingHTML.latency(sample.p95)}</span><span role="cell">{sample.count}</span>
            </div>
          </div>
        </div>
      </section>
      <section class="list-section" aria-labelledby="detections-heading">
        <h2 id="detections-heading">Detected patterns</h2><div
          id="detection-list"
          phx-update="stream"
        >
          <p id="detections-empty" class="hidden only:block muted py-6">
            No detections recorded in this range.
          </p>
          <div :for={{id, detection} <- @streams.detections} id={id} class="resource-row">
            <div>
              <p>{ReportingHTML.label(detection.guard)} · {detection.stage}</p><p class="resource-identifier muted">
                {detection.rule}
              </p>
            </div><span class="tabular-nums">{detection.count}</span>
          </div>
        </div><div id="service-error-list" phx-update="stream">
          <div :for={{id, error} <- @streams.service_errors} id={id} class="resource-row">
            <span>{ReportingHTML.label(error.id)}</span><span class="tabular-nums">{error.count} errors</span>
          </div>
        </div>
      </section>
    <% end %>
    <%= if "policies.read" in @current_scope.grants.permissions do %>
      <section
        id="overview-controls"
        class="list-section"
        aria-labelledby="active-controls-heading"
      >
        <h2 id="active-controls-heading">Active policy controls</h2>
        <%= if ReportingHTML.ok?(@reports.policy) do %>
          <% policy = ReportingHTML.value(@reports.policy) %>
          <p class="muted mt-2">
            {ReportingHTML.label(policy.snapshot.settings["profile"])} · {if policy.inherited?,
              do: "Inherited global policy",
              else: "Organization policy"}
          </p>
          <p class="resource-identifier mt-2">{policy.snapshot.version}</p><p class="resource-identifier muted">
            Checksum {policy.snapshot.checksum}
          </p>
          <div id="active-control-list" phx-update="stream">
            <div :for={{id, control} <- @streams.controls} id={id} class="resource-row">
              <div>
                <p>{ReportingHTML.label(control.id)}</p><p class="muted text-sm">
                  {if control.id in ~w(semantic moderation ner),
                    do: "Model-based",
                    else: "Deterministic"} · {Enum.join(control.settings["stages"], ", ")}
                  <span
                    :if={control.id in ~w(semantic moderation)}
                    id={"active-provider-#{control.id}"}
                  >
                    · {AiControlWeb.PolicyHTML.provider_label(control.settings["provider"])}
                  </span>
                </p>
              </div><span>{cond do
                !control.settings["enabled"] -> "Disabled"
                control.settings["required"] -> "Required"
                true -> "Optional"
              end}</span>
            </div>
          </div>
        <% else %>
          <p role="alert" class="report-error">The active policy is unavailable.</p>
        <% end %>
      </section>
    <% end %>
    <section
      :if={ReportingHTML.ok?(@reports.activity)}
      id="overview-recent"
      class="list-section"
      aria-labelledby="recent-events-heading"
    >
      <h2 id="recent-events-heading">Recent events</h2><div
        id="recent-event-list"
        phx-update="stream"
      >
        <p id="recent-events-empty" class="hidden only:block muted py-6">
          No events in this range.
        </p><ReportingHTML.event_row
          :for={{id, event} <- @streams.recent_events}
          id={id}
          event={event}
          organization_id={@current_scope.organization.id}
        />
      </div>
    </section>
    <section class="task-section" aria-labelledby="your-role-heading">
      <div>
        <h2 id="your-role-heading">Your role</h2><p class="muted text-sm mt-2">
          Administrative roles control who can manage members.
        </p>
      </div><div>
        <p id="current-membership-role" class="font-medium">
          {OrganizationUI.role_name(@current_scope.membership && @current_scope.membership.role)}
        </p><p :if={@current_scope.access_mode == :organizer} class="muted text-sm mt-2">
          You are accessing this workspace as the platform organizer.
        </p><.link
          :if={AiControl.Organizations.managers?(@current_scope)}
          navigate={~p"/organizations/#{@current_scope.organization.id}/members"}
          id="open-members"
          class="button-secondary mt-4"
        >Manage members <.icon name="hero-user-group" class="size-4" /></.link>
      </div>
    </section>
    <section class="task-section" aria-labelledby="your-access-heading">
      <div>
        <h2 id="your-access-heading">Your function access</h2><p class="muted text-sm mt-2">
          Capabilities are listed here as they are assigned. AI and reporting features become available as they are enabled.
        </p>
      </div><div id="permission-list" phx-update="stream">
        <p id="permissions-empty" class="hidden only:block muted">
          No function permissions assigned. Contact your organization administrator.
        </p><p :for={{id, permission} <- @streams.permissions} id={id} class="permission-row">
          {permission.label}
        </p>
      </div>
    </section>
    <section class="task-section" aria-labelledby="your-resources-heading">
      <div>
        <h2 id="your-resources-heading">Your resource access</h2><p class="muted text-sm mt-2">
          Both agent and model access are required to use AI.
        </p>
      </div><div class="space-y-3">
        <p>
          Agents:
          <span class="muted">{if "*" in @current_scope.grants.agents,
            do: "All organization agents",
            else: "#{length(@current_scope.grants.agents)} assigned"}</span>
        </p><p>
          Models:
          <span class="muted">{if "*" in @current_scope.grants.models,
            do: "All organization models",
            else: "#{length(@current_scope.grants.models)} assigned"}</span>
        </p>
      </div>
    </section>
  </div>
</Layouts.app>
