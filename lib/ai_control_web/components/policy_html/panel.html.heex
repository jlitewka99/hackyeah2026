<% draft_defaults = defaults(@form) %>
<div class="page-content" id="policy-page">
  <div class="policy-heading">
    <div>
      <h1>{if @target == :global, do: "Global policy", else: "Policies"}</h1>
      <p class="page-description">
        {if @target == :global,
          do: "Set the default protection for organizations that inherit your policy.",
          else: "Review the protection your organization uses and publish changes deliberately."}
      </p>
    </div>
    <button
      :if={@manage? && !@editing?}
      id="policy-new"
      type="button"
      class="button-primary"
      phx-click="new"
      phx-disable-with="Opening…"
    >
      <.icon name="hero-plus" class="size-4" /> Create a version
    </button>
  </div>

  <section class="list-section" aria-labelledby="effective-policy-heading" id="effective-policy">
    <div class="policy-heading">
      <div>
        <h2 id="effective-policy-heading">Active policy</h2>
        <p class="muted mt-2" id="policy-source">
          {cond do
            @target == :global -> "Global default"
            @current.inherited? -> "Inherited from the global policy"
            true -> "Organization policy"
          end}
          <span class="mx-2" aria-hidden="true">·</span>
          {String.capitalize(@current.version.settings["profile"])}
        </p>
      </div>
      <.link
        id="policy-effective-export"
        href={export_path(@target, @current_scope, @current.version.id)}
        class="button-secondary"
      >
        <.icon name="hero-arrow-down-tray" class="size-4" /> Export YAML
      </.link>
    </div>
    <p id="policy-schema" class="muted mt-3">
      Schema v{@current.version.settings["schema_version"]}
    </p>
    <dl class="policy-summary mt-6">
      <div>
        <dt>Personal data</dt><dd>
          {String.capitalize(@current.version.settings["rules"]["pii"]["action"])}
        </dd>
      </div>
      <div>
        <dt>Prompt injection</dt><dd>
          <span id="policy-active-provider">{provider_label(
            get_in(@current.version.settings, ["guards", "semantic", "provider"])
          )}</span>
          · {String.capitalize(@current.version.settings["rules"]["prompt_injection"]["action"])}
          <%= if label_rule_settings?(@current.version.settings, "prompt_injection") do %>
            · {Enum.join(@current.version.settings["guards"]["semantic"]["severities"], ", ")}
          <% else %>
            from {@current.version.settings["rules"]["prompt_injection"]["threshold"]}
          <% end %>
        </dd>
      </div>
      <div>
        <dt>Allowed models</dt><dd>
          {if @current.version.settings["allowed_models"] == [],
            do: "None",
            else: Enum.join(@current.version.settings["allowed_models"], ", ")}
        </dd>
      </div>
    </dl>
    <div id="policy-effective-tools" class="mt-4">
      <h3 class="font-medium">Allowed tools</h3>
      <p class="muted mt-1 break-words">
        {case get_in(@current.version.settings, ["tools", "allowed_tools"]) do
          nil -> "None · upgrade a draft to configure tool permissions"
          [] -> "None"
          tools -> Enum.map_join(tools, ", ", &tool_label/1)
        end}
      </p>
      <p class="muted text-sm mt-1">Operator resource grants are required for execution.</p>
    </div>
    <p class="muted text-sm mt-4 break-all">
      Version {short(@current.version.id)} · SHA-256 {@current.version.checksum}
    </p>
    <p class="muted mt-3">
      Deterministic detection and hourly request and token limits follow this active policy.
    </p>
    <details
      class="mt-4"
      id="policy-effective-details"
      open={MapSet.member?(@open_sections, "effective")}
    >
      <summary
        class="text-link cursor-pointer py-2"
        phx-click="toggle_section"
        phx-value-section="effective"
      >
        View all active settings
      </summary>
      <dl class="mt-3 space-y-3">
        <div :for={{category, rule} <- Enum.sort(@current.version.settings["rules"])}>
          <dt class="font-medium">{label(category)}</dt><dd class="muted">
            {String.capitalize(rule["action"])}
            <span :if={label_rule_settings?(@current.version.settings, category)}> · Selected severity labels</span>
            <span :if={!label_rule_settings?(@current.version.settings, category)}> from {rule[
              "threshold"
            ]}</span>
            · {rule["id"]}
          </dd>
        </div>
        <div :for={{guard, settings} <- Enum.sort(@current.version.settings["guards"])}>
          <dt class="font-medium">{label(guard)}</dt><dd class="muted">
            {cond do
              !settings["enabled"] -> "Disabled"
              settings["required"] -> "Required"
              guard == "granite" -> "Selected checks required"
              true -> "Optional"
            end} · {Enum.join(settings["stages"], ", ")}
            <span :if={Map.has_key?(settings, "severities")}> · Labels: {Enum.join(
              settings["severities"],
              ", "
            )}</span>
            <span :if={Map.has_key?(settings, "categories")}> · Categories: {Enum.join(
              settings["categories"],
              ", "
            )}</span>
            <span :if={guard == "ner"}> · {Enum.map_join(settings["entities"], ", ", &label/1)}</span>
          </dd>
        </div>
        <div :for={
          {guard, version} <- Enum.sort(Map.get(@current.version.settings, "detector_sets", %{}))
        }>
          <dt class="font-medium">
            {if guard == "ner" && @current.version.settings["schema_version"] in [5, 6],
              do: "Named entity weights",
              else: "#{label(guard)} detector set"}
          </dt><dd class="muted">{version}</dd>
        </div>
        <div :if={@current.version.settings["schema_version"] in [5, 6]}>
          <dt class="font-medium">NER rule set</dt><dd class="muted">
            {@current.version.settings["ner_model_set"]}
          </dd>
        </div>
        <div>
          <dt class="font-medium">Allowed agents</dt><dd class="muted break-all">
            {case @current.version.settings["allowed_agents"] do
              ["*"] -> "All agents in the organization"
              [] -> "None"
              agents -> Enum.join(agents, ", ")
            end}
          </dd>
        </div>
        <div :for={{agent, models} <- Enum.sort(@current.version.settings["agent_models"])}>
          <dt class="font-medium break-all">Agent {agent}</dt><dd class="muted break-all">
            {if models == [], do: "No models", else: Enum.join(models, ", ")}
          </dd>
        </div>
        <div :for={{scope, limits} <- Enum.sort(@current.version.settings["budgets"])}>
          <dt class="font-medium">{label(scope)} limits</dt><dd
            :for={{field, limit} <- Enum.sort(limits)}
            class="muted"
          >
            {label(field)}: {if is_nil(limit), do: "Not configured", else: limit}
          </dd>
        </div>
        <.granite_settings
          :if={is_map(@current.version.settings["granite"])}
          granite={@current.version.settings["granite"]}
        />
      </dl>
    </details>
    <button
      :if={@manage? && @target == :organization && !@current.inherited?}
      id="policy-inherit"
      type="button"
      class="button-secondary mt-4"
      phx-click="inherit"
      phx-disable-with="Restoring…"
      data-confirm="Use the current global policy? New requests will inherit future global changes. Your organization versions will be kept."
    >Use global policy</button>
    <p :if={@changed_elsewhere?} class="policy-notice mt-4" id="policy-updated" role="status">
      The policy changed while this page was open. Your unsaved edits are preserved. Review the current policy before activating a version.
    </p>
  </section>

  <section
    :if={@preview}
    class="list-section"
    id="policy-preview"
    aria-labelledby="preview-heading"
  >
    <div class="policy-heading">
      <div>
        <h2 id="preview-heading">Review version {short(@preview.id)}</h2><p class="muted mt-2">
          Created {Calendar.strftime(@preview.inserted_at, "%d %b %Y, %H:%M UTC")} · {if @preview.origin ==
                                                                                           "system",
                                                                                         do:
                                                                                           "System default",
                                                                                         else:
                                                                                           "Author #{@preview.author_id}"}
        </p>
      </div>
      <.link href={export_path(@target, @current_scope, @preview.id)} class="button-secondary">Export YAML</.link>
    </div>
    <p :if={@changes == []} class="muted mt-4">These settings match the active policy.</p>
    <div :if={@changes != []} class="policy-diff mt-4" id="policy-diff">
      <div
        :for={change <- @changes}
        class="policy-diff-row"
        id={"policy-diff-#{String.replace(change.path, ".", "-")}"}
      >
        <div>
          <p class="font-medium break-words">{diff_label(change.path)}</p>
          <p :if={diff_label(change.path) != change.path} class="muted text-sm break-all mt-1">
            {change.path}
          </p>
        </div>
        <p>
          <span class="muted">Current: </span><span class="break-words">{diff_value(
            change,
            @current.version.settings,
            :before
          )}</span>
        </p>
        <p>
          <span class="muted">New: </span><span class="break-words">{diff_value(
            change,
            @preview.settings,
            :after
          )}</span>
        </p>
        <p
          :if={change.path == "guards.semantic.provider"}
          id="policy-provider-change-notice"
          class="muted md:col-span-3"
        >
          {provider_change_notice(@preview.settings)}
        </p>
      </div>
    </div>
    <div :if={@manage? && @preview.id != @current.version.id} class="row-actions mt-6">
      <button
        :if={@review_stale?}
        id="policy-refresh-review"
        type="button"
        class="button-secondary"
        phx-click="refresh_review"
        phx-disable-with="Refreshing…"
      >Review latest changes</button>
      <button
        id="policy-activate"
        type="button"
        class="button-primary"
        phx-click={to_string(@preview_operation)}
        phx-value-id={@preview.id}
        disabled={@review_stale?}
        phx-disable-with="Activating…"
        data-confirm="Activate this version for new requests? Requests already in progress keep their current policy."
      >{if @preview_operation == :rollback,
        do: "Restore this version",
        else: "Activate this version"}</button>
      <button
        id="policy-preview-copy"
        type="button"
        class="button-secondary"
        phx-click="copy"
        phx-value-id={@preview.id}
        phx-disable-with="Opening…"
      >Edit as a new version</button>
    </div>
  </section>

  <section
    :if={@errors != []}
    class="policy-notice policy-errors mt-6"
    id="policy-errors"
    role="alert"
  >
    <h2>Review the configuration</h2>
    <ul class="mt-2 space-y-1">
      <li :for={{path, message} <- @errors}>
        <span class="font-medium">{path}</span>: {message}
      </li>
    </ul>
  </section>

  <section
    :if={@editing? && @manage?}
    class="list-section"
    id="policy-editor"
    aria-labelledby="editor-heading"
  >
    <h2 id="editor-heading">Create an immutable version</h2>
    <p class="muted mt-2">
      Profile defaults fill unspecified fields. Explicit overrides stay in place when you change the profile. Saving leaves the active policy unchanged.
    </p>
    <.form for={@form} id="policy-form" phx-change="validate" phx-submit="save" class="mt-6">
      <.input field={@form[:schema_version]} type="hidden" />
      <div class="policy-heading mb-6">
        <p id="policy-draft-schema" class="font-medium">Schema v{schema_version(@form)}</p>
        <button
          :if={upgrade_available?(@form)}
          id="policy-upgrade"
          type="button"
          class="button-secondary"
          phx-click="upgrade"
          phx-disable-with="Upgrading…"
        >{if schema_version(@form) == 6, do: "Apply workflow defaults", else: "Upgrade to v6"}</button>
      </div>
      <p :if={upgrade_available?(@form)} class="muted mb-6">
        Human approval and Granite start disabled in v6. Upgrade this draft to require workflow context and finite shared limits, and configure Knowledge and NER rule versions and imported signature sets. Existing explicit tool limits are preserved. Saving and activation remain separate steps.
      </p>
      <.granite_editor :if={schema_version(@form) == 6} form={@form} errors={@errors} />
      <section :if={schema_version(@form) == 6} id="policy-review" class="list-section mb-6">
        <h3>Human approval</h3>
        <p class="muted mt-2 mb-4">
          Selected operations wait for a human decision. Approval never overrides a block and does not pause the workflow deadline. Clients resume with the same operation key.
        </p>
        <.input
          type="checkbox"
          name="policy[review][enabled]"
          id="policy-review-enabled"
          label="Require approval for selected operations"
          checked={(@form[:review].value || %{})["enabled"] in [true, "true"]}
        />
        <.input
          type="select"
          multiple
          name="policy[review][tools][]"
          id="policy-review-tools"
          label="Tools requiring approval"
          options={Enum.map(AiControl.Tools.Catalog.all(), &{&1["name"], &1["name"]})}
          value={(@form[:review].value || %{})["tools"] || []}
        />
        <.input
          type="textarea"
          name="policy[review][llm_models]"
          id="policy-review-models"
          label="Models requiring approval"
          value={review_lines((@form[:review].value || %{})["llm_models"])}
          placeholder="One model per line, or * for all models"
        />
        <.input
          type="textarea"
          name="policy[review][delegation_agents]"
          id="policy-review-agents"
          label="Delegation targets requiring approval"
          value={review_lines((@form[:review].value || %{})["delegation_agents"])}
          placeholder="One agent UUID per line, or * for all targets"
        />
        <p :for={message <- field_errors(@errors, "review")} role="alert" class="report-error">
          {message}
        </p>
      </section>
      <section
        :if={schema_version(@form) in [5, 6]}
        id="policy-knowledge"
        class="list-section mb-6"
      >
        <h3>Knowledge and memory</h3>
        <p class="muted mt-2 mb-4">
          Source access and content checks apply to every read and write. Enabling retrieval does not enable memory writes.
        </p>
        <.input
          type="checkbox"
          name="policy[knowledge][enabled]"
          id="policy-knowledge-enabled"
          label="Enable Knowledge and retrieval"
          checked={(@form[:knowledge].value || %{})["enabled"] in [true, "true"]}
        />
        <.input
          type="checkbox"
          name="policy[knowledge][memory_write_enabled]"
          id="policy-memory-write-enabled"
          label="Allow explicit memory writes"
          checked={(@form[:knowledge].value || %{})["memory_write_enabled"] in [true, "true"]}
        />
        <.input
          type="select"
          multiple
          name="policy[knowledge][sources][]"
          id="policy-knowledge-sources"
          label="Allowed source kinds"
          options={~w(document memory)}
          value={(@form[:knowledge].value || %{})["sources"] || ~w(document memory)}
        />
        <.input
          type="select"
          multiple
          name="policy[knowledge][trust_levels][]"
          id="policy-knowledge-trust"
          label="Allowed source trust levels"
          options={~w(untrusted internal)}
          value={(@form[:knowledge].value || %{})["trust_levels"] || ~w(untrusted internal)}
        />
        <.input
          field={@form[:ner_model_set]}
          type="select"
          id="policy-ner-model-set"
          label="Pinned NER rule set"
          options={~w(pl-nkjp.v1 pl-nkjp.v2)}
        />
        <p :for={message <- field_errors(@errors, "knowledge")} role="alert" class="report-error">
          {message}
        </p>
      </section>
      <section
        :if={schema_version(@form) in [2, 3, 4, 5, 6]}
        id="policy-detector-sets"
        class="mb-6"
      >
        <h3 class="font-medium">Detector sets</h3>
        <p class="muted mt-2">
          Immutable sets keep detection reproducible.
        </p>
        <div :for={{guard, version} <- Enum.sort(@form[:detector_sets].value)} class="mt-2">
          <span id={"policy-set-label-#{guard}"} class="break-all">
            {if guard == "ner" && schema_version(@form) in [5, 6],
              do: "Named entity weights",
              else: label(guard)} · {version}
          </span>
          <.input
            :if={guard == "signatures" && schema_version(@form) in [5, 6]}
            name="policy[detector_sets][signatures]"
            id="policy-signature-selector"
            type="select"
            label="Signature set"
            value={version}
            options={@signature_options}
          />
          <.input
            :if={guard != "signatures" || schema_version(@form) not in [5, 6]}
            name={"policy[detector_sets][#{guard}]"}
            id={"policy-set-#{guard}"}
            value={version}
            type="hidden"
          />
        </div>
      </section>
      <.input
        field={@form[:profile]}
        type="select"
        label="Protection profile"
        options={[Relaxed: "relaxed", Balanced: "balanced", Strict: "strict"]}
        errors={field_errors(@errors, "profile")}
      />
      <div class="mt-6" id="policy-rules">
        <h3 class="font-medium">Detection rules</h3>
        <div :for={category <- category_catalog(@form)} class="policy-rule-row">
          <p class="font-medium">{label(category)}</p>
          <.input
            name={"policy[rules][#{category}][action]"}
            id={"policy-rule-#{category}-action"}
            value={nested(@form, :rules, category, "action")}
            type="select"
            label="Action override"
            options={
              [
                {"Profile default · #{label(draft_defaults["rules"][category]["action"])}", ""}
              ] ++ rule_actions(@form, category)
            }
            errors={field_errors(@errors, "rules.#{category}.action")}
          />
          <.input
            :if={!label_rule?(@form, category)}
            name={"policy[rules][#{category}][threshold]"}
            id={"policy-rule-#{category}-threshold"}
            value={nested(@form, :rules, category, "threshold")}
            type="number"
            min="0"
            max="1"
            step="0.01"
            label={
              if category == "prompt_injection" && injection_provider(@form) == "prompt_guard",
                do: "Malicious score threshold",
                else: "Threshold override"
            }
            placeholder={to_string(draft_defaults["rules"][category]["threshold"])}
            errors={field_errors(@errors, "rules.#{category}.threshold")}
          />
          <p :if={label_rule?(@form, category)} class="muted text-sm">
            Uses the selected severity labels, not a confidence threshold.
          </p>
          <.input
            name={"policy[rules][#{category}][id]"}
            id={"policy-rule-#{category}-id"}
            value={nested(@form, :rules, category, "id")}
            type="hidden"
          />
        </div>
      </div>
      <details
        class="policy-details"
        id="policy-guards"
        open={MapSet.member?(@open_sections, "guards")}
      >
        <summary phx-click="toggle_section" phx-value-section="guards">
          Guard requirements and stages
        </summary>
        <p class="muted mt-3">
          An unavailable required guard blocks the request. Select Profile default to remove an override.
        </p>
        <p
          :if={schema_version(@form) in [2, 3, 4, 5, 6]}
          id="policy-phase-order"
          class="muted text-sm mt-2"
        >
          Evaluation order: PII, secrets and signatures → decision and redaction → named entities → decision and redaction → semantic analysis and enabled response moderation.
        </p>
        <div :for={guard <- guard_catalog(@form)} class="policy-rule-row">
          <p class="font-medium">{label(guard)}</p>
          <.input
            name={"policy[guards][#{guard}][mode]"}
            id={"policy-guard-#{guard}-mode"}
            value={nested(@form, :guards, guard, "mode")}
            type="select"
            label="Requirement override"
            options={[
              {"Profile default · #{default_guard_mode(draft_defaults["guards"][guard])}", ""},
              {"Required", "required"},
              {"Optional", "optional"},
              {"Disabled", "disabled"}
            ]}
          />
          <.input
            :if={guard != "moderation"}
            name={"policy[guards][#{guard}][stages]"}
            id={"policy-guard-#{guard}-stages"}
            value={nested(@form, :guards, guard, "stages")}
            type="select"
            label="Stage override"
            options={[
              {"Profile default · #{Enum.join(draft_defaults["guards"][guard]["stages"], ", ")}",
               ""},
              {"Input", "input"},
              {"Output", "output"},
              {"Input and output", "input,output"}
            ]}
          />
          <p :if={guard == "moderation"} class="muted text-sm">
            Output only. Disabled by default.
          </p>
          <div
            :if={schema_version(@form) in [4, 5, 6] && guard == "semantic"}
            class="md:col-start-2 md:col-span-2"
          >
            <.input
              name="policy[guards][semantic][provider]"
              id="policy-semantic-provider"
              type="select"
              label="Injection provider"
              value={injection_provider(@form)}
              options={[
                {"Qwen3Guard Gen 0.6B", "qwen"},
                {"Llama Prompt Guard 2 86M", "prompt_guard"}
              ]}
              errors={field_errors(@errors, "guards.semantic.provider")}
              aria-describedby="policy-provider-help"
            />
            <p id="policy-provider-help" class="muted text-sm mt-2">
              A required provider must be available. There is no automatic fallback. Response moderation uses Qwen independently.
            </p>
            <p
              :if={injection_provider(@form) == "prompt_guard"}
              id="policy-score-help"
              class="muted text-sm mt-2"
            >
              Set the prompt injection threshold above. The maximum malicious score across all windows triggers the rule; this score is not a calibrated probability. Approved model access is required.
            </p>
          </div>
          <div
            :if={
              schema_version(@form) in [3, 4, 5, 6] &&
                (guard == "moderation" ||
                   (guard == "semantic" && injection_provider(@form) == "qwen"))
            }
            class="md:col-start-2 md:col-span-2"
          >
            <.input
              name={"policy[guards][#{guard}][severities][]"}
              id={"policy-#{guard}-severities"}
              type="select"
              multiple
              size="2"
              label="Severity labels that trigger the rule"
              value={
                nested(
                  @form,
                  :guards,
                  guard,
                  "severities",
                  draft_defaults["guards"][guard]["severities"]
                )
              }
              options={Enum.map(severities(), &{&1, &1})}
              errors={field_errors(@errors, "guards.#{guard}.severities")}
            />
            <p class="muted text-sm mt-2">
              Qwen returns severity labels.
              <span :if={guard == "semantic"}>Injection uses only the Jailbreak category.</span>
              <span :if={guard == "moderation"}>Select the response categories to check below.</span>
            </p>
            <.input
              :if={guard == "moderation"}
              name="policy[guards][moderation][categories][]"
              id="policy-moderation-categories"
              type="select"
              multiple
              size="8"
              label="Response safety categories"
              value={
                nested(
                  @form,
                  :guards,
                  guard,
                  "categories",
                  draft_defaults["guards"][guard]["categories"]
                )
              }
              options={Enum.map(safety_categories(), &{&1, &1})}
              errors={field_errors(@errors, "guards.moderation.categories")}
            />
          </div>
          <div :if={guard == "ner"} class="md:col-start-2 md:col-span-2">
            <.input
              name="policy[guards][ner][entities][]"
              id="policy-ner-entities"
              type="select"
              multiple
              size="5"
              label="Protected entity types"
              value={
                nested(
                  @form,
                  :guards,
                  "ner",
                  "entities",
                  draft_defaults["guards"]["ner"]["entities"]
                )
              }
              options={Enum.map(entity_types(), &{label(&1), &1})}
              errors={field_errors(@errors, "guards.ner.entities")}
            />
            <p class="muted text-sm mt-2">
              People and addresses are protected by default. Select places or organizations when their names are sensitive in your context.
            </p>
          </div>
        </div>
      </details>
      <details
        class="policy-details"
        id="policy-resources"
        open={MapSet.member?(@open_sections, "resources")}
      >
        <summary phx-click="toggle_section" phx-value-section="resources">
          Models and agents
        </summary>
        <div class="mt-4">
          <.input
            field={@form[:allowed_models]}
            type="textarea"
            rows="3"
            label="Allowed models"
            errors={field_errors(@errors, "allowed_models")}
          />
          <p class="muted text-sm mt-2">
            One model name per line. An empty list denies all models; * allows models verified by the model catalog.
          </p>
          <.input
            field={@form[:allowed_agents]}
            type="select"
            multiple
            label="Allowed agents"
            options={[
              {"All agents in this organization", "*"} | Enum.map(@agents, &{&1.name, &1.id})
            ]}
            errors={field_errors(@errors, "allowed_agents")}
          />
          <p class="muted text-sm mt-2">
            Choose all agents or specific agents. Selecting none denies all agents. Individual user grants still apply.
          </p>
        </div>
        <div :for={agent <- @agents} class="policy-rule-row">
          <p class="font-medium break-words">{agent.name}</p>
          <.input
            name={"policy[agent_models][#{agent.id}][mode]"}
            id={"policy-agent-#{agent.id}-mode"}
            value={nested(@form, :agent_models, agent.id, "mode", "inherit")}
            type="select"
            label="Model access"
            options={[
              {"Use allowed models", "inherit"},
              {"Restrict models", "restrict"},
              {"Deny all models", "deny"}
            ]}
          />
          <.input
            name={"policy[agent_models][#{agent.id}][models]"}
            id={"policy-agent-#{agent.id}-models"}
            value={nested(@form, :agent_models, agent.id, "models")}
            type="textarea"
            rows="2"
            label="Restricted models"
          />
        </div>
      </details>
      <details
        :if={schema_version(@form) in [2, 3, 4, 5, 6]}
        class="policy-details"
        id="policy-tools"
        open={MapSet.member?(@open_sections, "tools")}
      >
        <summary phx-click="toggle_section" phx-value-section="tools">Tool permissions</summary>
        <p id="policy-tool-help" class="muted mt-3">
          Select operations agents may request. Each operation also requires an exact resource grant from the operator. Selecting none denies all tools.
        </p>
        <fieldset class="mt-4 space-y-4" aria-describedby="policy-tool-help">
          <legend class="sr-only">Allowed tool operations</legend>
          <div :for={tool <- tool_catalog()}>
            <.input
              type="checkbox"
              name={"policy[tool_selection][#{tool["name"]}]"}
              id={tool_id(tool["name"])}
              checked={tool_selected?(@form, tool["name"])}
              label={tool["name"]}
              aria-describedby={tool_id(tool["name"]) <> "-description"}
            />
            <p id={tool_id(tool["name"]) <> "-description"} class="muted text-sm mt-1">
              {tool_description(tool["name"])}
            </p>
          </div>
          <div :for={tool <- unknown_tools(@form)} class="break-all">
            <.input
              type="checkbox"
              name={"policy[tool_selection][#{tool}]"}
              id={tool_id(tool)}
              checked={tool_selected?(@form, tool)}
              label={tool}
              aria-describedby={tool_id(tool) <> "-description"}
            />
            <p id={tool_id(tool) <> "-description"} class="muted text-sm mt-1">
              Unsupported operation. Preserved until you deselect it; it cannot execute.
            </p>
          </div>
        </fieldset>
        <p
          :for={message <- field_errors(@errors, "tools.allowed_tools")}
          class="field-error mt-3"
          role="alert"
        >
          {message}
        </p>
      </details>
      <details
        class="policy-details"
        id="policy-budgets"
        open={MapSet.member?(@open_sections, "budgets")}
      >
        <summary phx-click="toggle_section" phx-value-section="budgets">Budget limits</summary>
        <p id="policy-budget-help" class="muted mt-3">
          Request and token limits are enforced per UTC hour. An empty hourly limit (null in YAML) is not configured; zero denies new requests or token reservations. Activating a policy does not reset usage or existing reservations. Started tool calls count even when their result is blocked.
        </p>
        <p :if={schema_version(@form) not in [5, 6]} class="muted mt-2">
          Tool calls are limited per operator-assigned agent context, not per hour. A new policy or restart does not reset this count. Zero denies execution; an empty tool limit is not configured.
        </p>
        <p
          :if={schema_version(@form) in [5, 6]}
          id="policy-workflow-required"
          class="mt-3 notice-info"
        >
          Activating v5 or v6 requires a run and participant for every chat or tool call. Workflow limits are shared by all delegates for the entire run. All workflow limits must be finite; duration is in seconds and root delegation depth is zero.
        </p>
        <fieldset :for={{scope, fields} <- workflow_budget_fields(@form)} class="mt-4">
          <legend class="font-medium">{label(scope)}</legend>
          <div class="policy-budget-grid mt-3">
            <.input
              :for={field <- fields}
              name={"policy[budgets][#{scope}][#{field}]"}
              id={"policy-budget-#{scope}-#{field}"}
              value={nested(@form, :budgets, scope, field)}
              type="number"
              min="0"
              step="1"
              label={label(field)}
              placeholder={
                if scope == "workflow" && schema_version(@form) in [5, 6],
                  do: "Finite limit required",
                  else: "Not configured"
              }
              required={scope == "workflow" && schema_version(@form) in [5, 6]}
              errors={field_errors(@errors, "budgets.#{scope}.#{field}")}
            />
          </div>
        </fieldset>
      </details>
      <div class="row-actions mt-6">
        <.button id="policy-save" class="button-primary" phx-disable-with="Saving…">Save version</.button>
        <button id="policy-cancel" type="button" class="button-secondary" phx-click="cancel">Cancel</button>
      </div>
    </.form>
  </section>

  <section :if={@manage?} class="list-section" aria-labelledby="import-heading">
    <details id="policy-import-panel" open={MapSet.member?(@open_sections, "import")}>
      <summary
        class="font-medium"
        id="import-heading"
        phx-click="toggle_section"
        phx-value-section="import"
      >
        Import YAML
      </summary>
      <p class="muted mt-3">
        Paste a policy or upload one file up to 64 KiB. Import validates the settings and opens the editor; it does not activate them.
      </p>
      <.form
        for={@yaml_form}
        id="policy-import-form"
        phx-change="validate_yaml"
        phx-submit="import"
        class="mt-4"
      >
        <.input
          field={@yaml_form[:text]}
          type="textarea"
          rows="8"
          label="Policy YAML"
          class={["field-input policy-yaml", @yaml_errors != [] && "field-invalid"]}
          aria-invalid={if @yaml_errors != [], do: "true", else: "false"}
          aria-describedby={if @yaml_errors != [], do: "policy-import-errors"}
        />
        <div
          :if={@yaml_errors != []}
          id="policy-import-errors"
          role="alert"
          class="field-error mt-2"
        >
          <p :for={{path, message} <- @yaml_errors}>
            <span class="font-medium">{path}</span>: {message}
          </p>
          <p class="mt-2">
            Correct the policy and validate it again. Your editor changes are preserved.
          </p>
        </div>
        <label for={@uploads.policy_yaml.ref} class="font-medium block mt-4">Or choose a YAML file</label>
        <.live_file_input upload={@uploads.policy_yaml} class="policy-file-input mt-2" />
        <p :for={error <- upload_errors(@uploads.policy_yaml)} class="field-error" role="alert">
          {label(Atom.to_string(error))}
        </p>
        <div :for={entry <- @uploads.policy_yaml.entries} class="mt-2">
          <span>{entry.client_name} · {entry.progress}%</span>
          <button
            id={"cancel-upload-#{entry.ref}"}
            type="button"
            phx-click="cancel_upload"
            phx-value-ref={entry.ref}
            class="text-link ml-3"
          >Remove file</button>
          <p
            :for={error <- upload_errors(@uploads.policy_yaml, entry)}
            class="field-error"
            role="alert"
          >
            {label(Atom.to_string(error))}
          </p>
        </div>
        <.button id="policy-import" class="button-secondary mt-4" phx-disable-with="Validating…">Validate and open editor</.button>
      </.form>
    </details>
  </section>

  <section class="list-section" aria-labelledby="history-heading">
    <h2 id="history-heading">Version history</h2>
    <p class="muted mt-2">
      Saved versions never change. Reactivating an earlier version preserves its author and settings.
    </p>
    <div id="policy-version-list" phx-update="stream" class="mt-4">
      <p id="policy-history-empty" class="hidden only:block muted py-6">
        No organization versions yet. The global policy provides the defaults.
      </p>
      <div :for={{id, row} <- @streams.versions} id={id} class="resource-row">
        <div class="min-w-0 flex-1">
          <p class="font-medium">
            {String.capitalize(row.version.settings["profile"])} · {short(row.id)}
          </p>
          <p class="muted text-sm mt-1">
            Saved {Calendar.strftime(row.version.inserted_at, "%d %b %Y, %H:%M UTC")}
          </p>
          <p
            class="resource-status mt-2"
            data-status={if row.active?, do: "active", else: "inactive"}
          >
            {cond do
              row.active? -> "Active"
              row.activation -> "Previously active"
              true -> "Saved · not active"
            end}
          </p>
          <p :if={row.activation} class="muted text-sm mt-1">
            Last activated {Calendar.strftime(row.activation.inserted_at, "%d %b %Y, %H:%M UTC")}
          </p>
        </div>
        <div class="row-actions">
          <button
            id={"policy-view-#{row.id}"}
            type="button"
            class="button-secondary"
            phx-click="view"
            phx-value-id={row.id}
            phx-disable-with="Opening…"
          >Review</button>
          <button
            :if={@manage? && row.activation && !row.active?}
            id={"policy-rollback-#{row.id}"}
            type="button"
            class="button-secondary"
            phx-click="review_rollback"
            phx-value-id={row.id}
            phx-disable-with="Opening…"
          >Restore</button>
        </div>
      </div>
    </div>
  </section>
</div>
